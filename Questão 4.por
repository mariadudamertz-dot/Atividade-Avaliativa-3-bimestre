programa
{
	
	funcao inicio()
	{
		inteiro numeroA
		inteiro numeroB
		inteiro numeroC
		inteiro numeroD
		inteiro numeroE

		escreva("fale um valor: ")
		leia(numeroA, numeroB, numeroC, numeroD, numeroE)

          se(numeroA > numeroB e numeroA > numeroC e numeroA > numeroD e numeroA > numeroE){
          	escreva(numeroA, " é maior")
          }

          se(numeroB > numeroA e numeroB > numeroC e numeroB > numeroD e numeroB > numeroE){
          	escreva(numeroB, " é maior")
          }

          se(numeroC > numeroA e numeroC > numeroB e numeroC > numeroD e numeroC >numeroE){
          	escreva(numeroC, " é maior")
          }

          se(numeroD > numeroA e numeroD > numeroB e numeroD > numeroC e numeroD >numeroE){
          	escreva(numeroD, " é maior")
          }

          se(numeroE > numeroA e numeroE > numeroB e numeroE > numeroC e numeroE >numeroD){
          	escreva(numeroE, " é maior")
          }
		
	}
}
